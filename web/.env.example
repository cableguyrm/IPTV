# ---- Core ----
DATABASE_URL=postgres://btn:btn_dev_pw@localhost:5432/btntv
# Public base URL (used for links in emails, Stripe redirects)
APP_URL=http://localhost:3000
# Long random string (openssl rand -hex 32). Used for signing guest ticket links & cron auth.
APP_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# ---- Initial admin (used by `npm run admin:create`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026

# ---- Payments: Stripe (cards + Apple Pay / Google Pay wallets) ----
# Leave empty to disable card checkout. Bank transfer (manual verification) always works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP) for password resets & renewal reminders ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BTN TV STREAMZ <no-reply@example.com>"

# ---- WhatsApp Cloud API (Meta) for renewal reminders ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name (must exist in your Meta Business account)
WHATSAPP_TEMPLATE=renewal_reminder

# ---- IPTV provider API (generic REST adapter) ----
# Only configure for a provider you are authorised to resell. Per-panel adapter key is set in Admin > Panels.
PROVIDER_GENERIC_BASE_URL=
PROVIDER_GENERIC_API_KEY=

# ---- Privacy-friendly analytics (optional, Plausible-compatible) ----
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
